# ============================================
# SISTEM PEMINJAMAN RUANGAN KAMPUS
# Environment Configuration Template
# ============================================

# APPLICATION SETTINGS
APP_NAME="Sistem Peminjaman Ruangan Kampus"
APP_ENVIRONMENT=Development
APP_URL=http://localhost:5000
APP_PORT=5000
HTTPS_PORT=5001

# FRONTEND INTEGRATION
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# DATABASE (SQLite for Development - No installation needed)
DB_CONNECTION=Data Source=RoomBooking.db

# FEATURE FLAGS
ENABLE_SWAGGER=true
ENABLE_CORS=true
ENABLE_HTTPS_REDIRECT=true

# LOGGING
LOG_LEVEL=Information
LOG_TO_FILE=false

# NOTE: Copy this file to .env and update values
# NEVER commit .env file to git!